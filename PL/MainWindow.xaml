<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="WindowLoaded" Closed="WindowClosed"
        Title="WeirdAid" Height="1080px" Width="1920px">
    <Window.Resources>
        <!-- Bool to Visibility Converter -->
        <local:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>

        <local:RiskRangeViewModel x:Key="RiskRangeVM"/>

        <!-- Style for the risk range textbox -->
        <Style x:Key="RiskRangeTextBoxStyle" TargetType="TextBox">

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" CornerRadius="16">
                            <ScrollViewer x:Name="PART_ContentHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="Background" Value="#96ACBC"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>

            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>

        </Style>

        <!-- Style for the Apply and Cancel buttons -->
        <Style x:Key="ApplyCancelStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <!-- Default State -->
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />

            <!-- Triggers -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SetRiskRangeTB}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="48*"/>
            <RowDefinition Height="855*"/>
            <RowDefinition Height="51*"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0">
                <GradientStop Color="#87A6BC" Offset="0"/>
                <GradientStop Color="#CC223D4E" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <!-- Header -->
        <Grid Grid.ColumnSpan="2" Background="#284151" Panel.ZIndex="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="408*"/>
                <ColumnDefinition Width="95.545"/>
                <ColumnDefinition Width="914.544"/>
                <ColumnDefinition Width="323*"/>
                <ColumnDefinition Width="89*"/>
                <ColumnDefinition Width="90*"/>
            </Grid.ColumnDefinitions>
            <Grid.Effect>
                <DropShadowEffect Opacity="0.25" BlurRadius="10" ShadowDepth="7.3" Direction="-90"/>
            </Grid.Effect>
            <TextBlock Text="WeirdAid" FontSize="48" Foreground="White" FontWeight="Regular" TextAlignment="Center" Width="374" HorizontalAlignment="Center" VerticalAlignment="Center" Height="64" />
            <!-- Header Button -->
            <Border HorizontalAlignment="Left" Margin="1,28,0,27" Background="#FF7690A3" Width="890" Grid.Column="2" CornerRadius="16">
                <Grid>
                    <Button Content="Volunteers" Style="{StaticResource HeaderButtonStyle}" Click="OpenVolunteerInListWindow" Margin="50,8,650,8"/>
                    <Button Content="Calls" Style="{StaticResource HeaderButtonStyle}" Margin="375,8,375,8"/>
                    <Button Content="Assignments" Style="{StaticResource HeaderButtonStyle}" Width="190" Margin="650,8,50,8"/>
                </Grid>
            </Border>
            <Grid Grid.Column="4" Height="75" Margin="6,0,8,0" VerticalAlignment="Center">
                <Ellipse Fill="#FF7690A3" Width="75" Height="75"/>
                <TextBlock Text="EH" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="36"/>
            </Grid>
        </Grid>

        <!-- Left Section -->
        <Border Margin="134,164,226,192" Background="#FF284151" CornerRadius="16" Grid.Row="2">
            <Border.Effect>
                <DropShadowEffect Opacity="0.25" BlurRadius="10" ShadowDepth="7.3" Direction="-75"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="83*"/>
                    <RowDefinition Height="83*"/>
                    <RowDefinition Height="66*"/>
                    <RowDefinition Height="17*"/>
                </Grid.RowDefinitions>
                <Label x:Name="RiskRangeLabel"                              
                        VerticalAlignment="Stretch" FontWeight="SemiBold" 
                        Opacity="{Binding ElementName=SetRiskRangeTB, Path=IsFocused, Converter={StaticResource BoolToOpacityConverter}}" 
                        Grid.Column="1" HorizontalAlignment="Stretch" Height="80" Width="235">
                        <Viewbox Width="210" Height="60">
                            <TextBlock Text="{Binding RiskRangeView ,Mode=OneWay}" />
                        </Viewbox>
                </Label>

                <!-- Bottom Buttons -->
                <Button Content="Initialize Database" 
                        Click="InitDB" 
                        Margin="50,44,50,43" FontSize="36" Grid.Row="1" Grid.ColumnSpan="2"
                        Width="Auto" Height="auto"/>
                
                <Button Content="Reset Databse"  
                        Click="ResetDB" FontSize="36" 
                        Margin="50,41,50,11" Grid.Row="2" Grid.ColumnSpan="2"
                        Width="Auto" Height="auto"/>

                <!-- Placeholder TextBlock -->
                <Viewbox Panel.ZIndex="1" Margin="50,57,39,60">
                    <TextBlock Text="Enter Risk Range"
                           Background="#96ACBC"
                           Foreground="#99FFFFFF"
                           FontWeight="DemiBold"
                           FontSize="26"
                           TextAlignment="Center"
                           IsHitTestVisible="False"
                           Opacity="{Binding ElementName=SetRiskRangeTB, Path=IsFocused, Converter={StaticResource BoolToOpacityConverter}}"/>
                </Viewbox>
                <TextBox x:Name="SetRiskRangeTB"
                         Text="{Binding riskRangeViewModel.RiskRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RiskRangeTextBoxStyle}" 
                         Margin="39,43,26,43" 
                         VerticalAlignment="Stretch" 
                         FontWeight="SemiBold"
                         FontSize="36" HorizontalAlignment="Stretch"
                         Width="Auto" Height="auto"/>
                <!-- Apply Button -->
                <Button Content="Apply"
                        Width="107" Height="80"
                        Margin="41,0,0,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Grid.Column="1"
                        Click="ApplyButton_Click"
                        Style="{StaticResource ApplyCancelStyle}">
                </Button>

                <!-- Cancel Button -->
                <Button Content="Cancel"
                    Width="107" Height="80"
                    Margin="160,0,0,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Grid.Column="1"
                    Style="{StaticResource ApplyCancelStyle}">
                </Button>
            </Grid>
        </Border>

        <!-- Right Section -->
        <Border Background="#FF284151" CornerRadius="16" BorderThickness="0" Margin="8,48,152,544" Grid.Column="1" Grid.RowSpan="2" Grid.Row="1">
            <Border.Effect>
                <DropShadowEffect Opacity="0.25" BlurRadius="10" ShadowDepth="7.3" Direction="-75"/>
            </Border.Effect>
            <Grid>
                <Label 
                       FontSize="48" FontWeight="SemiBold" 
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" 
                       Background="#007690A3">
                    <Viewbox Margin="40,30,40,30">
                        <TextBlock Text="{Binding ConfigTime, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" />
                    </Viewbox>
                </Label>
            </Grid>
        </Border>
        <Border Background="#FF284151" BorderThickness="1" Margin="8,331,152,7" CornerRadius="16" Grid.Column="1" Grid.Row="2">
            <Border.Effect>
                <DropShadowEffect Opacity="0.25" BlurRadius="10" ShadowDepth="7.3" Direction="-75"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45*"/>
                    <ColumnDefinition Width="702*"/>
                    <ColumnDefinition Width="45*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="80*"/>
                    <RowDefinition Height="80*"/>
                    <RowDefinition Height="80*"/>
                    <RowDefinition Height="80*"/>
                    <RowDefinition Height="80*"/>
                    <RowDefinition Height="80*"/>
                    <RowDefinition Height="30*"/>
                </Grid.RowDefinitions>
                <Button Content="+1 Sec" Margin="0,4,0,11" Width="Auto" Height="auto" Click="PlusOneSec" Grid.Column="1" Grid.Row="1"/>
                <Button Content="+1 Min" Margin="0,10,0,9" Width="Auto" Height="Auto" Click="PlusOneMin" Grid.Row="2" Grid.Column="1"/>
                <Button Content="+1 Hour" Margin="0,8,0,9" Width="Auto" Height="Auto" Click="PlusOneHour" Grid.Row="3" Grid.Column="1"/>
                <Button Content="+1 Day" Margin="0,13,0,8" Width="Auto" Height="Auto" Click="PlusOneDay" Grid.Row="4" Grid.Column="1"/>
                <Button Content="+1 Month" Margin="0,11,0,10" Width="Auto" Height="Auto" Click="PlusOneMonth" Grid.Row="5" Grid.Column="1"/>
                <Button Content="+1 Year" Margin="0,10,0,10" Width="Auto" Height="Auto" Click="PlusOneYear" Grid.Row="6" Grid.Column="1"/>
            </Grid>
        </Border>
    </Grid>
</Window>
