<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closed="Window_Closed"
        Title="WeirdAid" MinWidth="1350" MinHeight="850">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0">
                <GradientStop Color="#87A6BC" Offset="0"/>
                <GradientStop Color="#CC223D4E" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <!-- Header -->
        <Grid Background="#284151" Panel.ZIndex="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86*"/>
                <ColumnDefinition Width="295"/>
                <ColumnDefinition Width="114*"/>
                <ColumnDefinition Width="915*"/>
                <ColumnDefinition Width="255*"/>
                <ColumnDefinition Width="158"/>
                <ColumnDefinition Width="97*"/>
            </Grid.ColumnDefinitions>
            <Grid.Effect>
                <DropShadowEffect Opacity="0.25" BlurRadius="10" ShadowDepth="7.3" Direction="-90"/>
            </Grid.Effect>
            <TextBlock Text="WeirdAid" FontSize="48" Foreground="White" FontWeight="Regular" TextAlignment="Center" Width="268" HorizontalAlignment="Left" VerticalAlignment="Top" Height="64" Margin="0,28,0,0" Grid.Column="1" />
            <!-- Header Button -->
            <Border Background="#FF7690A3" Grid.Column="3" CornerRadius="16" MinWidth="300" MaxWidth="500" MaxHeight="55">
                <Grid>
                    <RadioButton Content="Volunteers" Style="{StaticResource HeaderRadioButtonStyle}" Click="CurrentViewToVolunteerInList" HorizontalAlignment="Left" Width="140" Margin="50,0,0,0" Height="40"/>
                    <RadioButton Content="Calls" Style="{StaticResource HeaderRadioButtonStyle}" Height="40" Margin="0,7,50,7" HorizontalAlignment="Right" Width="64"/>
                </Grid>
            </Border>
            <Grid Grid.Column="5" Margin="11,18,34,17">
                <Ellipse Fill="#FF7690A3" Height="75" Width="75"/>
                <Button Content="EH" FontSize="36" Click="CurrentViewToAdmin" VerticalAlignment="Center" HorizontalAlignment="Center" Width="51" Height="49"/>
            </Grid>
        </Grid>

        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
