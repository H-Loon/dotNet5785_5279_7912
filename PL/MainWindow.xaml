<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="WindowLoaded" Closed="WindowClosed"
        Title="WeirdAid" Height="1080px" Width="1920px">
    <Window.Resources>
        <!-- Bool to Visibility Converter -->
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Style for the risk range textbox -->
        <Style x:Key="RiskRangeTextBoxStyle" TargetType="TextBox">

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" CornerRadius="16">
                            <ScrollViewer x:Name="PART_ContentHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="Background" Value="#96ACBC"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>

            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>

        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1080"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0">
                <GradientStop Color="#87A6BC" Offset="0"/>
                <GradientStop Color="#CC223D4E" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="321*"/>
            <ColumnDefinition Width="319*"/>
        </Grid.ColumnDefinitions>
        <!-- Header -->
        <Grid Margin="0,0,0,970" Grid.ColumnSpan="2" Background="#284151" Height="110" Panel.ZIndex="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="1094"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.Effect>
                <DropShadowEffect Opacity="0.25" BlurRadius="10" ShadowDepth="7.3" Direction="-90"/>
            </Grid.Effect>
            <TextBlock Text="WeirdAid" FontSize="48" Foreground="White" FontWeight="Regular" TextAlignment="Center" Width="375" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <!-- Header Button -->
            <Border HorizontalAlignment="Left" Margin="85,28,0,27" Background="#FF7690A3" Height="55" Width="890" Grid.Column="1" CornerRadius="16">
                <Grid>
                    <Button Content="Volunteers" Style="{StaticResource HeaderButtonStyle}" Click="OpenVolunteerInListWindow" Margin="50,8,650,8"/>
                    <Button Content="Calls" Style="{StaticResource HeaderButtonStyle}" Margin="375,8,375,8"/>
                    <Button Content="Assignments" Style="{StaticResource HeaderButtonStyle}" Width="190" Margin="650,8,50,8"/>
                </Grid>
            </Border>
            <Grid Grid.Column="2" Height="75" Width="75" Margin="235,0,86,0" VerticalAlignment="Center">
                <Ellipse Fill="#FF7690A3" Width="75" Height="75"/>
                <TextBlock Text="EH" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="36"/>
            </Grid>
        </Grid>

        <!-- Left Section -->
        <Border Margin="134,358,0,240" HorizontalAlignment="Left" Width="650" Background="#FF284151" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect Opacity="0.25" BlurRadius="10" ShadowDepth="7.3" Direction="-75"/>
            </Border.Effect>
            <Grid>

                <Label Content="{Binding RiskRange}" Margin="365,43,0,0" VerticalAlignment="Top" Height="80" Width="235" FontWeight="SemiBold" Visibility="{Binding ElementName=SetRiskRangeTB, Converter={StaticResource BoolToVisibilityConverter}}" />
                <!-- Bottom Buttons -->
                <Button Content="Initialize Database" Command="{Binding InitializeDataCommand}" HorizontalAlignment="Center" Width="550" Click="InitDB" Margin="0,191,0,177" Height="80" FontSize="36"/>
                <Button Content="Reset Databse" Command="{Binding CancelCommand}" Click="ResetDB" FontSize="36" Height="80" Margin="0,326,0,43" Width="550"/>
                <TextBox x:Name="SetRiskRangeTB"
                         Style="{StaticResource RiskRangeTextBoxStyle}" 
                         Margin="50,43,0,0" 
                         VerticalAlignment="Top" 
                         Height="80" 
                         Width="235" 
                         FontWeight="SemiBold"
                         local:WatermarkService.Watermark="Set risk range">
                </TextBox>
            </Grid>
        </Border>

        <!-- Right Section -->
        <Border Background="#FF284151" CornerRadius="16" BorderThickness="0" Margin="960,180,160,567" Width="800" Height="300" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Opacity="0.25" BlurRadius="10" ShadowDepth="7.3" Direction="-75"/>
            </Border.Effect>
            <Grid>
                <Label 
                       Width="600" Height="200" 
                       FontSize="36" FontWeight="SemiBold" 
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" 
                       Background="#007690A3">
                    <TextBlock Text="{Binding ConfigTime, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" />
                </Label>
            </Grid>
        </Border>
        <Border Background="#FF284151" BorderThickness="1" Margin="960,525,160,55" Grid.ColumnSpan="2" Height="500" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect Opacity="0.25" BlurRadius="10" ShadowDepth="7.3" Direction="-75"/>
            </Border.Effect>
            <Grid>
                <Button Content="+1 Sec" Margin="49,43,49,401" Width="700" Height="55" Click="PlusOneSec"/>
                <Button Content="+1 Min" Margin="49,118,49,325" Width="700" Height="55" Click="PlusOneMin"/>
                <Button Content="+1 Hour" Margin="49,191,49,252" Width="700" Height="55" Click="PlusOneHour"/>
                <Button Content="+1 Day" Margin="49,266,49,177" Width="700" Height="55" Click="PlusOneDay"/>
                <Button Content="+1 Month" Margin="49,341,49,102" Width="700" Height="55" Click="PlusOneMonth"/>
                <Button Content="+1 Year" Margin="49,414,49,29" Width="700" Height="55" Click="PlusOneYear"/>
            </Grid>
        </Border>
    </Grid>
</Window>
