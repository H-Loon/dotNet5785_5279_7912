<Application x:Class="PL.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PL"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:CustomColorTheme BaseTheme="Dark" PrimaryColor="#FF7690A3" SecondaryColor="#284151" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="Themes/ButtonStyles.xaml"/>
                <ResourceDictionary Source="Themes/ComboBoxStyles.xaml"/>
                <ResourceDictionary Source="Themes/LabelStyles.xaml"/>
                <ResourceDictionary Source="Themes/ListViewStyles.xaml"/>
                <ResourceDictionary Source="Themes/TextBoxStyles.xaml"/>
                <ResourceDictionary Source="Themes/TabControlStyles.xaml"/>
                <ResourceDictionary Source="Themes/BindablePasswordBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
