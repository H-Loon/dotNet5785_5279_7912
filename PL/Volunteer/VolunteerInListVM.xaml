<UserControl x:Class="PL.Volunteer.VolunteerInListVM"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PL.Volunteer"
             DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
             mc:Ignorable="d" 
             d:DesignHeight="970" d:DesignWidth="1920">
    <UserControl.Resources>
        <local:VolunteerField x:Key="VolunteerField"/>
    </UserControl.Resources>
    <Grid>
        <Border Margin="125,79,695,75" Grid.Row="1" Background="#FF284151" CornerRadius="16,16,16,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18*"/>
                    <ColumnDefinition Width="494*"/>
                    <ColumnDefinition Width="18*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80*"/>
                    <RowDefinition Height="690*"/>
                    <RowDefinition Height="30*"/>
                </Grid.RowDefinitions>
                <ComboBox Style="{DynamicResource ComboBoxStyle1}" ItemsSource="{Binding Source={StaticResource VolunteerField}}"
                  SelectedValue="{Binding VolunteerInListField, Mode=TwoWay}"
                  SelectionChanged="QueryVolunteerList"                        
                  Margin="198,0,0,0"
                  Width="190"
                  Grid.Column="1"
                  Cursor="Hand"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Height="30"/>

                <TextBlock Grid.Column="1" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Ordered By:" VerticalAlignment="Center" Foreground="White" FontSize="32" FontWeight="SemiBold"/>
                <ListView ItemsSource="{Binding VolunteerInList}" Style="{StaticResource ListViewStyle1}" ItemContainerStyle="{StaticResource ListViewItemVisual1}" SelectedItem="{Binding SelectedVolunteer}" MouseDoubleClick="lsvVolunteersList_MouseDoubleClick" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" Grid.Column="1" Grid.Row="1">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Delete" Click="btnDelete_Click" CommandParameter="{Binding}"  Style="{StaticResource ListViewButton}" MinWidth="100"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="Is Active" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsEnabled="False" 
                                  IsChecked="{Binding IsActive}" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Completed" DisplayMemberBinding="{Binding CompletedCalls}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="Canceled" DisplayMemberBinding="{Binding CanceledCalls}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="In treatment" DisplayMemberBinding="{Binding CallInTreatment}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="Call Type" DisplayMemberBinding="{Binding CurrentCallType}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <Button Margin="0,0,10,0" VerticalAlignment="Center" Height="40" Grid.Column="1" HorizontalAlignment="Right" Width="40" Click="VolunteerVAdd">
                    <Button.Content>
                        <Grid Height="30">
                            <Line 
                      Stroke="White"
                      StrokeThickness="3"
                      RenderSize="16,16"
                      StrokeLineJoin="Round"
                      Fill="White"
                      Width="30" Height="30"  StrokeEndLineCap="Round" StrokeStartLineCap="Round" X1="25" X2="5" Y1="15" Y2="15"/>
                            <Line 
                      Stroke="White"
                      StrokeThickness="3"
                      RenderSize="16,16"
                      StrokeLineJoin="Round"
                      Fill="White"
                      Width="30" Height="30" StrokeEndLineCap="Round" StrokeStartLineCap="Round" Y1="25" Y2="5" X1="15" X2="15"/>
                        </Grid>
                    </Button.Content>
                </Button>
            </Grid>
        </Border>
        <Border Margin="0,79,120,75" Grid.Row="1" Background="#FF284151" CornerRadius="16,16,16,16" HorizontalAlignment="Right" Width="500">
            <Grid>
                <ContentControl  Content="{Binding VolunteerView}" Panel.ZIndex="1" Margin="27,27,27,27"/>
                <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center" Width="Auto" Margin="100,0,100,0">
                    <TextBlock HorizontalAlignment="Center" Text="Select a volunteer" VerticalAlignment="Center" Foreground="#99FFFFFF" FontSize="28" TextWrapping="Wrap"/>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
