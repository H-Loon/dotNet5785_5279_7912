<Window x:Class="PL.Volunteer.VolunteerInListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Volunteer"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Title="WeirdAid" Height="1080" Width="1920">
    <Window.Resources>
        <local:VolunteerField x:Key="VolunteerField"/>

        <Style x:Key="ComboBoxEntityType" TargetType="ComboBox">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Main Border -->
                            <Border x:Name="Border" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="0" 
                            CornerRadius="16">
                                <Grid>
                                    <!-- Content -->
                                    <ContentPresenter ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      Margin="10,0,35,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center">
                                    </ContentPresenter>

                                    <!-- ToggleButton for DropDown -->
                                    <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderBrush="Transparent"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Width="20" Height="20"
                                          Margin="0,0,10,0">
                                        <ToggleButton.Content>
                                            <Polygon Points="2,5 14,5 8,14"
                                                 Stroke="White"
                                                 StrokeThickness="3"
                                                 StrokeLineJoin="Round"
                                                 Fill="White"
                                                 Width="16" Height="16"/>

                                        </ToggleButton.Content>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid MaxHeight="300">
                                    <!-- Border with Matching Background -->
                                    <Border Background="{TemplateBinding Background}"
                                            BorderThickness="0"
                                            CornerRadius="8">
                                        <ScrollViewer>
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>

                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#96ACBC" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0">
                <GradientStop Color="#87A6BC" Offset="0"/>
                <GradientStop Color="#CC223D4E" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <!-- Header -->
        <Grid Background="#284151" Panel.ZIndex="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86*"/>
                <ColumnDefinition Width="295"/>
                <ColumnDefinition Width="114*"/>
                <ColumnDefinition Width="915*"/>
                <ColumnDefinition Width="255*"/>
                <ColumnDefinition Width="158"/>
                <ColumnDefinition Width="97*"/>
            </Grid.ColumnDefinitions>
            <Grid.Effect>
                <DropShadowEffect Opacity="0.25" BlurRadius="10" ShadowDepth="7.3" Direction="-90"/>
            </Grid.Effect>
            <TextBlock Text="WeirdAid" FontSize="48" Foreground="White" FontWeight="Regular" TextAlignment="Center" Width="268" HorizontalAlignment="Left" VerticalAlignment="Top" Height="64" Margin="0,28,0,0" Grid.Column="1" />
            <!-- Header Button -->
            <Border Margin="0,28,0,28" Background="#FF7690A3" Grid.Column="3" CornerRadius="16" MinWidth="500">
                <Grid MinWidth="500">
                    <Button Content="Volunteers" Style="{StaticResource HeaderButtonStyle}" HorizontalAlignment="Left" Width="140" Margin="20,0,0,0" Height="40"/>
                    <Button Content="Calls" Style="{StaticResource HeaderButtonStyle}" HorizontalAlignment="Center" Width="64" Height="40"/>
                    <Button Content="Assignments" Style="{StaticResource HeaderButtonStyle}" HorizontalAlignment="Right" Width="160" Margin="0,0,20,0" Height="40"/>
                </Grid>
            </Border>
            <Grid Grid.Column="5" Margin="11,18,34,17">
                <Ellipse Fill="#FF7690A3" Height="75" Width="75"/>
                <TextBlock Text="EH" Foreground="White" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
        <Border  HorizontalAlignment="Left" Height="800" Margin="125,0,0,75" Grid.Row="1" VerticalAlignment="Bottom" Width="1100" Background="#FF284151" CornerRadius="16,16,16,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32*"/>
                    <ColumnDefinition Width="494*"/>
                    <ColumnDefinition Width="18*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80*"/>
                    <RowDefinition Height="690*"/>
                    <RowDefinition Height="30*"/>
                </Grid.RowDefinitions>
                <ComboBox ItemsSource="{Binding Source={StaticResource VolunteerField}}"
                          SelectedValue="{Binding Field, Mode=TwoWay}"
                          SelectionChanged="ComboBox_SelectionChanged"
                          Style="{StaticResource ComboBoxEntityType}"
                          Margin="192,28,617,22"
                          Width="190"
                          Height="30"
                          Grid.Column="1"
                          Cursor="Hand"
                          Background="#FF7690A3"/>

                <TextBlock Grid.Column="1" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Ordered By:" VerticalAlignment="Center" Foreground="White" FontSize="32" FontWeight="SemiBold"/>
                <ListView Grid.Column="1" Grid.Row="1" ItemsSource="{Binding VolunteerInList}" Style="{StaticResource RoundedListViewStyle}" ItemContainerStyle="{StaticResource RoundedListViewItemStyle}" Foreground="#99FFFFFF" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="Is Active" DisplayMemberBinding="{Binding IsActive}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="Completed" DisplayMemberBinding="{Binding CompletedCalls}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="Canceled" DisplayMemberBinding="{Binding CanceledCalls}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="In treatment" DisplayMemberBinding="{Binding CallInTreatment}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="Call Type" DisplayMemberBinding="{Binding CurrentCallType}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
        <Button HorizontalAlignment="Left" Margin="1150,100,0,0" Grid.Row="1" VerticalAlignment="Top" Width="38" Height="38">
            <TextBlock Text="+" Foreground="White" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Height="55" IsHitTestVisible="False"/>
        </Button>
    </Grid>
</Window>
