<Window x:Class="PL.Volunteer.VolunteerInListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Volunteer"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closed="Window_Closed"
        Title="WeirdAid" Height="1080" Width="1920">
    <Window.Resources>
        <local:VolunteerField x:Key="VolunteerField"/>
    </Window.Resources>
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0">
                <GradientStop Color="#87A6BC" Offset="0"/>
                <GradientStop Color="#CC223D4E" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <!-- Header -->
        <Grid Background="#284151" Panel.ZIndex="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86*"/>
                <ColumnDefinition Width="295"/>
                <ColumnDefinition Width="114*"/>
                <ColumnDefinition Width="915*"/>
                <ColumnDefinition Width="255*"/>
                <ColumnDefinition Width="158"/>
                <ColumnDefinition Width="97*"/>
            </Grid.ColumnDefinitions>
            <Grid.Effect>
                <DropShadowEffect Opacity="0.25" BlurRadius="10" ShadowDepth="7.3" Direction="-90"/>
            </Grid.Effect>
            <TextBlock Text="WeirdAid" FontSize="48" Foreground="White" FontWeight="Regular" TextAlignment="Center" Width="268" HorizontalAlignment="Left" VerticalAlignment="Top" Height="64" Margin="0,28,0,0" Grid.Column="1" />
            <!-- Header Button -->
            <Border Margin="0,28,0,28" Background="#FF7690A3" Grid.Column="3" CornerRadius="16" MinWidth="500">
                <Grid MinWidth="500">
                    <Button Content="Volunteers" Style="{StaticResource HeaderButtonStyle}" HorizontalAlignment="Left" Width="140" Margin="20,0,0,0" Height="40"/>
                    <Button Content="Calls" Style="{StaticResource HeaderButtonStyle}" HorizontalAlignment="Center" Width="64" Height="40"/>
                    <Button Content="Assignments" Style="{StaticResource HeaderButtonStyle}" HorizontalAlignment="Right" Width="160" Margin="0,0,20,0" Height="40"/>
                </Grid>
            </Border>
            <Grid Grid.Column="5" Margin="11,18,34,17">
                <Ellipse Fill="#FF7690A3" Height="75" Width="75"/>
                <TextBlock Text="EH" Foreground="White" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
        <Border Margin="125,79,695,75" Grid.Row="1" Background="#FF284151" CornerRadius="16,16,16,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32*"/>
                    <ColumnDefinition Width="494*"/>
                    <ColumnDefinition Width="18*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80*"/>
                    <RowDefinition Height="690*"/>
                    <RowDefinition Height="30*"/>
                </Grid.RowDefinitions>
                <ComboBox Style="{DynamicResource ComboBoxStyle1}" ItemsSource="{Binding Source={StaticResource VolunteerField}}"
                          SelectedValue="{Binding VolunteerInListField, Mode=TwoWay}"
                          SelectionChanged="QueryVolunteerList"                        
                          Margin="198,0,0,0"
                          Width="190"
                          Grid.Column="1"
                          Cursor="Hand"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Height="30"/>

                <TextBlock Grid.Column="1" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Ordered By:" VerticalAlignment="Center" Foreground="White" FontSize="32" FontWeight="SemiBold"/>
                <ListView Grid.Column="1" ItemsSource="{Binding VolunteerInList}" Style="{StaticResource ListViewStyle1}" ItemContainerStyle="{StaticResource ListViewItemVisual1}" SelectedItem="{Binding SelectedVolunteer}" MouseDoubleClick="lsvVolunteersList_MouseDoubleClick" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" Grid.ColumnSpan="2" Margin="0,1,36,0" Grid.Row="1">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Delete" Click="btnDelete_Click" CommandParameter="{Binding}"  Style="{StaticResource ListViewButton}" MinWidth="100"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="Is Active" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsEnabled="False" 
                                          IsChecked="{Binding IsActive}" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Completed" DisplayMemberBinding="{Binding CompletedCalls}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="Canceled" DisplayMemberBinding="{Binding CanceledCalls}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="In treatment" DisplayMemberBinding="{Binding CallInTreatment}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="Call Type" DisplayMemberBinding="{Binding CurrentCallType}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <Button Margin="0,0,10,0" VerticalAlignment="Center" Height="40" Grid.Column="1" HorizontalAlignment="Right" Width="40" Click="OpenVolunteerWindowAdd">
                    <Button.Content>
                        <Grid Height="30">
                            <Line 
                              Stroke="White"
                              StrokeThickness="3"
                              RenderSize="16,16"
                              StrokeLineJoin="Round"
                              Fill="White"
                              Width="30" Height="30"  StrokeEndLineCap="Round" StrokeStartLineCap="Round" X1="25" X2="5" Y1="15" Y2="15"/>
                            <Line 
                              Stroke="White"
                              StrokeThickness="3"
                              RenderSize="16,16"
                              StrokeLineJoin="Round"
                              Fill="White"
                              Width="30" Height="30" StrokeEndLineCap="Round" StrokeStartLineCap="Round" Y1="25" Y2="5" X1="15" X2="15"/>
                        </Grid>
                    </Button.Content>
                </Button>
            </Grid>
        </Border>
        <Border Margin="0,79,120,75" Grid.Row="1" Background="#FF284151" CornerRadius="16,16,16,16" HorizontalAlignment="Right" Width="500">
            <Grid>
                <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center" Width="Auto" Margin="100,0,100,0">
                    <TextBlock HorizontalAlignment="Center" Text="Select a volunteer" VerticalAlignment="Center" Foreground="#99FFFFFF" FontSize="28" TextWrapping="Wrap"/>
                </Viewbox>
            </Grid>
        </Border>

    </Grid>
</Window>
