<UserControl x:Class="PL.Volunteer.Menu.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PL.Volunteer.Menu"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
             mc:Ignorable="d" 
             d:DesignHeight="970" d:DesignWidth="1920">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Label">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="BorderBrush" Value="#99ffffff"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                </Trigger>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
        </Grid.RowDefinitions>
        <Border Background="#FF284151" CornerRadius="16" MaxHeight="800" MaxWidth="500" Margin="0,25,0,25">
            <Border.Effect>
                <DropShadowEffect Opacity="0.25" BlurRadius="10" ShadowDepth="7.3" Direction="-90"/>
            </Border.Effect>
            <Grid>
                <TextBlock Text="You have no current call" Foreground="#99ffffff" FontSize="36" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Grid Visibility="{Binding VolunteerMainView.IsNotCall, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25*"/>
                        <ColumnDefinition Width="450*"/>
                        <ColumnDefinition Width="25*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25*"/>
                        <RowDefinition Height="450*"/>
                        <RowDefinition Height="100*"/>
                        <RowDefinition Height="25*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#FF7690A3" CornerRadius="16" Grid.Column="1" Grid.Row="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="27"/>
                                <ColumnDefinition Width="93*"/>
                                <ColumnDefinition Width="103*"/>
                                <ColumnDefinition Width="27"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>

                                <RowDefinition Height="27*"/>
                                <RowDefinition Height="25*"/>
                                <RowDefinition Height="25*"/>
                                <RowDefinition Height="25*"/>
                                <RowDefinition Height="25*"/>
                                <RowDefinition Height="25*"/>
                                <RowDefinition Height="25*"/>
                                <RowDefinition Height="50*"/>

                            </Grid.RowDefinitions>

                            <Label Content="{Binding CallIdLabel, Mode = OneTime}" Background="#96ACBC" Grid.Row="0"  Grid.ColumnSpan="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Height="40" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,0"/>

                            <TextBlock Grid.Row="1" Text="Call type:" FontSize="22" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Height="38" Width="163"/>
                            <TextBox Text="{Binding Call.CallType, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>


                            <TextBlock Grid.Row="2" Text="Description" FontSize="22" Grid.Column="1" VerticalAlignment="Center" Height="38" Width="125" HorizontalAlignment="Left"/>
                            <TextBox Text="{Binding Call.Description, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="2" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>


                            <TextBlock Grid.Row="3" Text="Adress :" FontSize="22" Grid.Column="1" VerticalAlignment="Center" Height="38" Width="125" HorizontalAlignment="Left"/>
                            <TextBox Text="{Binding Call.Address, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="3" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>

                            <TextBlock Grid.Row="4" Text="StartTime :" FontSize="22" Grid.Column="1" VerticalAlignment="Center" Height="38" Width="125" HorizontalAlignment="Left"/>
                            <TextBox Text="{Binding Call.StartTime, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="4" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>


                            <TextBlock Grid.Row="5" Text="MaxTime :" FontSize="22" Grid.Column="1" VerticalAlignment="Center" Height="38" Width="125" HorizontalAlignment="Left"/>
                            <TextBox Text="{Binding Call.MaxTime, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="5" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>


                            <TextBlock Grid.Row="6" Text="Status :" FontSize="22" Grid.Column="1" VerticalAlignment="Center" Height="38" Width="125" HorizontalAlignment="Left"/>
                            <TextBox Text="{Binding Call.Status, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="6" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>

                            <TextBlock Grid.Row="7" Text="Assign list :" FontSize="22" Grid.Column="1" VerticalAlignment="Top" Height="38" Width="163" HorizontalAlignment="Left"/>
                            <ScrollViewer Grid.Row="7" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.RowSpan="1" Grid.ColumnSpan="2" Margin="120,0,0,0" >
                                <TextBlock Text="{Binding AssignList, Mode = OneWay}" HorizontalAlignment="Left" />
                            </ScrollViewer>

                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="Complete" Click="CompleteCall" Grid.Column="0" Margin="0,10,5,0" MaxWidth="220"/>
                        <Button Content="Cancel" Click="CancelCall" Grid.Column="1" Margin="5,10,0,0" MaxWidth="220"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <Border Background="#FF284151" CornerRadius="16" MaxHeight="800" MaxWidth="500" Grid.Column="1" Margin="0,25,0,25">
            <Border.Effect>
                <DropShadowEffect Opacity="0.25" BlurRadius="10" ShadowDepth="7.3" Direction="-90"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25*"/>
                    <ColumnDefinition Width="450*"/>
                    <ColumnDefinition Width="25*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25*"/>
                    <RowDefinition Height="550*"/>
                    <RowDefinition Height="25*"/>
                </Grid.RowDefinitions>
                <Border CornerRadius="16" Background="#FF7690A3" Grid.Column="1" Grid.Row="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="27"/>
                            <ColumnDefinition Width="93*"/>
                            <ColumnDefinition Width="103*"/>
                            <ColumnDefinition Width="27"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Label Content="{Binding VolunteerIdLabel, Mode = OneTime}" Background="#96ACBC" Grid.Row="0"  Grid.ColumnSpan="2" Grid.Column="1" Height="40" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        
                        <Label Grid.Row="1" Content="Name:" FontSize="22" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Height="38"/>
                        <TextBox Text="{Binding Volunteer.Name, Mode = TwoWay}" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" Height="20"/>
                        
                        <Label Grid.Row="2" Content="Phone:" FontSize="22" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Height="38"/>
                        <TextBox Text="{Binding Volunteer.Phone, Mode = TwoWay}" Grid.Row="2" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" Height="20"/>
                        
                        <Label Grid.Row="3" Content="Email:" FontSize="22" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Height="38"/>
                        <TextBox Text="{Binding Volunteer.Email, Mode = TwoWay}" Grid.Row="3" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" Height="20"/>
                        
                        <Label Grid.Row="4" Content="Password:" FontSize="22" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Height="38"/>
                        <TextBox Text="{Binding Volunteer.Password, Mode = OneWayToSource}" Grid.Row="4" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" Height="20"/>
                        
                        <Label Grid.Row="5" Content="Address:" FontSize="22" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Height="38"/>
                        <TextBox Text="{Binding Volunteer.Address, Mode = TwoWay}" Grid.Row="5" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" Height="20"/>

                        <Label Grid.Row="6" Content="Active:" FontSize="22" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" Height="38"/>
                        <ToggleButton
                            IsChecked="{Binding Volunteer.IsActive, Mode = TwoWay}"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}"
                            Background="#FF284151"
                            HorizontalAlignment="Left" Grid.Row="6" VerticalAlignment="Center" Grid.Column="2"
                            ToolTip="Make the volunteer Avtive/Non-Active" Cursor="Hand">
                            <materialDesign:ToggleButtonAssist.SwitchTrackOnBackground>
                                <SolidColorBrush Color="#FF618F8D" />
                            </materialDesign:ToggleButtonAssist.SwitchTrackOnBackground>
                            <materialDesign:ToggleButtonAssist.SwitchTrackOffBackground>
                                <SolidColorBrush Color="#FF284151" />
                            </materialDesign:ToggleButtonAssist.SwitchTrackOffBackground>
                        </ToggleButton>
                        <Label Grid.Row="7" Content="Max distance:" FontSize="22" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Height="38"/>
                        <TextBox Text="{Binding Volunteer.MaxDistance, Mode = TwoWay}" HorizontalAlignment="Left" Grid.Row="7" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" Height="21" Width="170"/>
                        
                        <Label Grid.Row="8" Content="Distance type:" FontSize="22" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Height="38"/>
                        <TextBlock Text="{Binding Volunteer.DistanceType, Mode=OneWay}" HorizontalAlignment="Left" Grid.Row="8" VerticalAlignment="Center" Grid.Column="2" Height="24" Width="170"/>
                        
                        <Label Grid.Row="9" Content="Completed calls:" FontSize="22" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Height="38"/>
                        <TextBlock Text="{Binding Volunteer.CompletedCalls, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="9" TextWrapping="Wrap" VerticalAlignment="Center" Height="24" Grid.Column="2" Width="170"/>
                        
                        <Label Grid.Row="10" Content="Canceled calls:" FontSize="22" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Height="38"/>
                        <TextBlock Text="{Binding Volunteer.CanceledCalls, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="10" TextWrapping="Wrap" VerticalAlignment="Center" Height="24" Grid.Column="2" Width="170"/>
                        
                        <Label Grid.Row="11" Content="Over dated calls:" FontSize="22" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Height="38"/>
                        <TextBlock Text="{Binding Volunteer.OverDatedCalls, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="11" TextWrapping="Wrap" VerticalAlignment="Center" Height="24" Grid.Column="2" Width="170"/>
                        
                        

                        <Button Content="Update" Click="UpdateVolunteer" Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,5,10,5"/>

                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
