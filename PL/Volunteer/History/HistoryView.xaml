<UserControl x:Class="PL.Volunteer.History.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PL.Volunteer.History"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
             mc:Ignorable="d" 
             d:DesignHeight="970" d:DesignWidth="1920">

    <UserControl.Resources>
        <local:ClosedCallInListField x:Key="ClosedCallInListField"/>
        <local:CallType x:Key="CallType" />
        <!--<local:BoCallType x:Key="TypeCall" />
        <local:BoCallType x:Key="TypeClosed" />-->
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="145*"/>
            <ColumnDefinition Width="1577*"/>
            <ColumnDefinition Width="145*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="118*"/>
            <RowDefinition Height="747*"/>
            <RowDefinition Height="105*"/>
        </Grid.RowDefinitions>
        <Border  BorderThickness="1" Grid.Row="1" Background="#FF284151" CornerRadius="16,16,16,16" Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="1">
                    <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="Ordered By:" VerticalAlignment="Center" Foreground="White" FontSize="32" FontWeight="SemiBold"/>
                </Viewbox>
                <ComboBox Style="{DynamicResource ComboBoxStyle1}" ItemsSource="{Binding Source={StaticResource ClosedCallInListField}}"
                    SelectedValue="{Binding TypeClosed, Mode=TwoWay}"
                    SelectionChanged="QueryAndOrderCallList"
                    Grid.Column="2"
                    Cursor="Hand" MinWidth="80" VerticalAlignment="Center" Margin="20,0,0,0"/>

                <ListView ItemsSource="{Binding CallClosedInList}"  Style="{StaticResource ListViewStyle1}" ItemContainerStyle="{StaticResource ListViewItemVisual1}" Grid.Row="1" Grid.ColumnSpan="6" Grid.Column="1" Margin="0,0,40,0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="Type of call" DisplayMemberBinding="{Binding CallType}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}" />
                            <GridViewColumn Header="Adresse" DisplayMemberBinding="{Binding Address}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}" />
                            <GridViewColumn Header="Start time" DisplayMemberBinding="{Binding StartTime}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}" />
                            <GridViewColumn Header="Assign time" DisplayMemberBinding="{Binding AssignTime}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="End time" DisplayMemberBinding="{Binding EndedTime}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="End type" DisplayMemberBinding="{Binding EndType}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <Viewbox Grid.Column="3">
                    <TextBlock TextWrapping="Wrap" Text="Filtred By:" VerticalAlignment="Center" Foreground="White" FontSize="32" FontWeight="SemiBold" Grid.Column="3" Height="42" Margin="10,0,0,0" />
                </Viewbox>

                <ComboBox Style="{DynamicResource ComboBoxStyle1}" ItemsSource="{Binding Source={StaticResource CallType}}" SelectedValue="{Binding TypeCall, Mode=TwoWay}"
                    SelectionChanged="QueryAndOrderCallList"
                    Grid.Column="4"
                    Cursor="Hand" MinWidth="80" VerticalAlignment="Center" Margin="10,0,0,0"/>

            </Grid>
        </Border>
    </Grid>
</UserControl>
