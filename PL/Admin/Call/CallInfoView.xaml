<UserControl x:Class="PL.Admin.Call.CallInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PL.Admin.Call"
             DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="450">
    <UserControl.Resources>
        <local:CallType x:Key="CallType"/>
        <local:Status x:Key="Status"/>
        
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Label">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Width" Value="170"/>
            <Setter Property="BorderBrush" Value="#99ffffff"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                </Trigger>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="16" Background="#FF7690A3" Grid.Column="1" Grid.Row="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="27"/>
                <ColumnDefinition Width="93*"/>
                <ColumnDefinition Width="103*"/>
                <ColumnDefinition Width="27"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>

                <RowDefinition Height="27*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>

            </Grid.RowDefinitions>

            <Label Content="{Binding IdLabel, Mode = OneWay}" Background="#96ACBC" Grid.Row="0"  Grid.ColumnSpan="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Height="40" FontSize="24" FontWeight="SemiBold" Margin="0.2,5,0,0" />

            <TextBlock Grid.Row="1" Text="Type of the Call:" FontSize="22" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Height="38" Width="163"/>
            <TextBox Text="{Binding Call.CallType, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>


            <TextBlock Grid.Row="2" Text="Description" FontSize="22" Grid.Column="1" VerticalAlignment="Center" Height="38" Width="125" HorizontalAlignment="Left"/>
            <TextBox Text="{Binding Call.Description, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="2" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>


            <TextBlock Grid.Row="3" Text="Adress :" FontSize="22" Grid.Column="1" VerticalAlignment="Center" Height="38" Width="125" HorizontalAlignment="Left"/>
            <TextBox Text="{Binding Call.Address, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="3" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>


            <TextBlock Grid.Row="4" Text="Lattitude :" FontSize="22" Grid.Column="1" VerticalAlignment="Center" Height="38" Width="125" HorizontalAlignment="Left"/>
            <TextBox Text="{Binding Call.Latitude, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="4" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>


            <TextBlock Grid.Row="5" Text="Longitude :" FontSize="22" Grid.Column="1" VerticalAlignment="Center" Height="38" Width="125" HorizontalAlignment="Left"/>
            <TextBox Text="{Binding Call.Longitude, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="5" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>


            <TextBlock Grid.Row="6" Text="StartTime :" FontSize="22" Grid.Column="1" VerticalAlignment="Center" Height="38" Width="125" HorizontalAlignment="Left"/>
            <TextBox Text="{Binding Call.StartTime, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="6" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>


            <TextBlock Grid.Row="7" Text="MaxTime :" FontSize="22" Grid.Column="1" VerticalAlignment="Center" Height="38" Width="125" HorizontalAlignment="Left"/>
            <TextBox Text="{Binding Call.MaxTime, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="7" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>


            <TextBlock Grid.Row="8" Text="Status :" FontSize="22" Grid.Column="1" VerticalAlignment="Center" Height="38" Width="125" HorizontalAlignment="Left"/>
            <TextBox Text="{Binding Call.Status, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="8" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>

            <TextBlock Grid.Row="9" Text="Assign list :" FontSize="22" Grid.Column="1" VerticalAlignment="Top" Height="38" Width="163" HorizontalAlignment="Left"/>
            <ScrollViewer Grid.Row="9" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" >
                <TextBlock Text="{Binding AssignList, Mode = OneWay}" HorizontalAlignment="Left" FontSize="14"/>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
