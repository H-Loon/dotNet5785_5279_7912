<UserControl x:Class="PL.Admin.Call.CallInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PL.Admin.Call"
             DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="450">
    <UserControl.Resources>
        <local:CallType x:Key="CallType"/>
        <local:Status x:Key="Status"/>

        <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxStyle2}"/>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="TB">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="TextBlock.Foreground" Value="Black"/>
            <Setter Property="TextBlock.FontSize" Value="10"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Width" Value="170"/>
            <Setter Property="BorderBrush" Value="#99ffffff"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                </Trigger>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="16" Background="#FF7690A3" Grid.Column="1" Grid.Row="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="27"/>
                <ColumnDefinition Width="93*"/>
                <ColumnDefinition Width="103*"/>
                <ColumnDefinition Width="27"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>

                <RowDefinition Height="27*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="25*"/>

            </Grid.RowDefinitions>

            <Label Grid.Row="1" Content="Type of the Call:" FontSize="22" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Height="38" Width="163"/>
            <TextBox Text="{Binding Call.CallType, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>


            <Label Grid.Row="2" Content="Description" FontSize="22" Grid.Column="1" VerticalAlignment="Center" Height="38" Width="125" HorizontalAlignment="Left"/>
            <TextBox Text="{Binding Call.Description, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="2" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>


            <TextBox Text="{Binding Call.Address, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="3" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>
            <Label Grid.Row="3" Content="Adress :" FontSize="22" Grid.Column="1" VerticalAlignment="Center" Height="38" Width="125" HorizontalAlignment="Left"/>


            <TextBox Text="{Binding Call.Latitude, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="4" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>
            <Label Grid.Row="4" Content="Lattitude :" FontSize="22" Grid.Column="1" VerticalAlignment="Center" Height="38" Width="125" HorizontalAlignment="Left"/>


            <TextBox Text="{Binding Call.Longitude, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="5" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>
            <Label Grid.Row="5" Content="Longitude :" FontSize="22" Grid.Column="1" VerticalAlignment="Center" Height="38" Width="125" HorizontalAlignment="Left"/>


            <TextBox Text="{Binding Call.StartTime, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="6" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>
            <Label Grid.Row="6" Content="StartTime :" FontSize="22" Grid.Column="1" VerticalAlignment="Center" Height="38" Width="125" HorizontalAlignment="Left"/>


            <TextBox Text="{Binding Call.MaxTime, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="7" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>
            <Label Grid.Row="7" Content="MaxTime :" FontSize="22" Grid.Column="1" VerticalAlignment="Center" Height="38" Width="125" HorizontalAlignment="Left"/>


            <TextBox Text="{Binding Call.Status, Mode = OneWay}" HorizontalAlignment="Left" Grid.Row="8" TextWrapping="Wrap" VerticalAlignment="Center" Grid.Column="2" IsReadOnly="True" Height="20" Width="NaN"/>
            <Label Grid.Row="8" Content="Status :" FontSize="22" Grid.Column="1" VerticalAlignment="Center" Height="38" Width="125" HorizontalAlignment="Left"/>

            <Label Grid.Row="9" Content="Assign list :" FontSize="22" Grid.Column="1" VerticalAlignment="Center" Height="38" Width="163" HorizontalAlignment="Left"/>
            <ScrollViewer Grid.Row="9" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" >
                <TextBox Text="{Binding AssignList, Mode = OneWay}" HorizontalAlignment="Left" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
