<UserControl x:Class="PL.Admin.Volunteer.VolunteerInListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PL.Admin.Volunteer"
             DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
             mc:Ignorable="d" 
             d:DesignHeight="970" d:DesignWidth="1920">
    <UserControl.Resources>
        <local:VolunteerField x:Key="VolunteerField"/>
        <local:IsDeletable x:Key="IsDeletable"/>
        <local:VolunteerActiveField x:Key="VolunteerActiveField"/>
    </UserControl.Resources>
    <Grid>
        <Border Margin="125,79,695,75" Grid.Row="1" Background="#FF284151" CornerRadius="16,16,16,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="39*"/>
                    <ColumnDefinition Width="170*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="164*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="475*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="39*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80*"/>
                    <RowDefinition Height="690*"/>
                    <RowDefinition Height="30*"/>
                </Grid.RowDefinitions>
                <Viewbox Grid.Column="1" Height="42">
                    <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="Ordered By:" VerticalAlignment="Center" Foreground="White" FontSize="32" FontWeight="SemiBold"/>
                </Viewbox>

                <ComboBox Style="{DynamicResource ComboBoxStyle1}" ItemsSource="{Binding Source={StaticResource VolunteerField}}"
                     SelectedValue="{Binding VolunteerInListField, Mode=TwoWay}"
                     SelectionChanged="QueryVolunteerList"                        
                     Margin="10,0,0,0"
                     Width="80"
                     Grid.Column="2"
                     Cursor="Hand"
                     HorizontalAlignment="Left" VerticalAlignment="Center" Height="30" MinWidth="80"/>
                <Viewbox Grid.Column="3" Height="42" Margin="10,0,0,0">
                    <TextBlock TextWrapping="Wrap" Text="Filtred By:" VerticalAlignment="Center" Foreground="White" FontSize="32" FontWeight="SemiBold" Grid.Column="3" Height="42" Margin="10,0,0,0" />
                </Viewbox>
                <ComboBox Style="{DynamicResource ComboBoxStyle1}" ItemsSource="{Binding Source={StaticResource VolunteerActiveField}}"
                       SelectedValue="{Binding VActiveField, Mode=TwoWay}"
                       SelectionChanged="QueryVolunteerList"
                       Width="80"
                       Margin="10,0,0,0"
                       Grid.Column="4"
                       Cursor="Hand"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Height="30" MinWidth="80"/>
                <ListView ItemsSource="{Binding VolunteerInList}" Style="{StaticResource ListViewStyle1}" ItemContainerStyle="{StaticResource ListViewItemVisual1}" SelectedItem="{Binding SelectedVolunteer}" MouseDoubleClick="lsvVolunteersList_MouseDoubleClick" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" Grid.Row="1" Grid.ColumnSpan="6" Grid.Column="1">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Delete" Click="btnDelete_Click" CommandParameter="{Binding}" Style="{StaticResource ListViewButton}" MinWidth="100" IsEnabled="{Binding Id, Converter={StaticResource IsDeletable}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="Is Active" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsEnabled="False" 
                               IsChecked="{Binding IsActive}" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Completed" DisplayMemberBinding="{Binding CompletedCalls}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="Canceled" DisplayMemberBinding="{Binding CanceledCalls}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="In treatment" DisplayMemberBinding="{Binding CallInTreatment}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                            <GridViewColumn Header="Call Type" DisplayMemberBinding="{Binding CurrentCallType}" Width="Auto" HeaderContainerStyle="{StaticResource GridViewHeaderStyle}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <Button Margin="2,0,0,0" VerticalAlignment="Center" Height="40" Grid.Column="6" HorizontalAlignment="Left" Width="40" Click="VolunteerVAdd">
                    <Button.Content>
                        <Grid Height="30">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="17*"/>
                                <RowDefinition Height="13*"/>
                            </Grid.RowDefinitions>
                            <Line 
                   Stroke="White"
                   StrokeThickness="3"
                   RenderSize="16,16"
                   StrokeLineJoin="Round"
                   Fill="White"
                   Width="30" Height="30"  StrokeEndLineCap="Round" StrokeStartLineCap="Round" X1="25" X2="5" Y1="15" Y2="15" Grid.RowSpan="2"/>
                            <Line 
                   Stroke="White"
                   StrokeThickness="3"
                   RenderSize="16,16"
                   StrokeLineJoin="Round"
                   Fill="White"
                   Width="30" Height="30" StrokeEndLineCap="Round" StrokeStartLineCap="Round" Y1="25" Y2="5" X1="15" X2="15" Grid.RowSpan="2"/>
                        </Grid>
                    </Button.Content>
                </Button>
            </Grid>
        </Border>
        <Border Margin="0,79,120,75" Grid.Row="1" Background="#FF284151" CornerRadius="16,16,16,16" HorizontalAlignment="Right" Width="500">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="27,27,27,27" Panel.ZIndex="1">
                    <ContentControl  Content="{Binding VolunteerInfo}" Panel.ZIndex="1"/>
                </ScrollViewer>
                <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center" Width="Auto" Margin="100,0,100,0">
                    <TextBlock HorizontalAlignment="Center" Text="Select a volunteer" VerticalAlignment="Center" Foreground="#99FFFFFF" FontSize="28" TextWrapping="Wrap"/>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
