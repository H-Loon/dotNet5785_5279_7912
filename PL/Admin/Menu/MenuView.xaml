<UserControl x:Class="PL.Admin.Menu.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PL.Admin.Menu"
             Loaded="Window_Loaded" 
             DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1350">
    <UserControl.Resources>
        <Style x:Key="RoundedLabelAdmin" TargetType="Label" BasedOn="{StaticResource RoundedLabel}">
            <!-- Default State -->
            <Setter Property="Opacity" Value="1" />

            <!-- Triggers -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SetRiskRangeTB}" Value="True">
                    <Setter Property="Opacity" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style for the Apply and Cancel buttons -->
        <Style x:Key="ApplyCancelStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <!-- Default State -->
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />

            <!-- Triggers -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SetRiskRangeTB}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="164*"/>
            <RowDefinition Height="261*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <!-- Left Section -->
        <Border Background="#FF284151" CornerRadius="16" Grid.Row="1" HorizontalAlignment="Center" Grid.RowSpan="1" MinWidth="500" MaxWidth="700">
            <Border.Effect>
                <DropShadowEffect Opacity="0.25" BlurRadius="10" ShadowDepth="7.3" Direction="-75"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="215*"/>
                    <ColumnDefinition Width="208*"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="80*"/>
                    <RowDefinition Height="80*"/>
                    <RowDefinition Height="80*"/>
                    <RowDefinition Height="20"/>
                </Grid.RowDefinitions>
                <Label Style="{StaticResource RoundedLabelAdmin}"                              
                        VerticalAlignment="Stretch" FontWeight="SemiBold"  
                        Grid.Column="2" HorizontalAlignment="Stretch" Grid.Row="1" Margin="5,0,0,10">
                    <Viewbox>
                        <TextBlock Text="{Binding RiskRange ,Mode=OneWay}" Margin="7,5,7,5" />
                    </Viewbox>
                </Label>

                <!-- Bottom Buttons -->

                <Button 
                    Click="InitDB" FontSize="36" 
                    Grid.Row="2" Grid.ColumnSpan="2" 
                    MinHeight="40" MinWidth="100" 
                    RenderTransformOrigin="0.5,0.5" 
                    VerticalContentAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" Grid.Column="1" Padding="1,1,1,1" VerticalAlignment="Center" Margin="0,0,0,5">
                    <Viewbox>
                        <TextBlock Text="Initialize Database" IsHitTestVisible="False" Width="339" TextAlignment="Center" VerticalAlignment="Center"/>
                    </Viewbox>
                </Button>


                <Button  
                    Click="ResetDB" FontSize="36" 
                    MinHeight="40" MinWidth="100"
                    HorizontalContentAlignment="Stretch" 
                    VerticalContentAlignment="Stretch" 
                    Grid.ColumnSpan="2" 
                    Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0">
                    <Viewbox>
                        <TextBlock Text="Reset Database" IsHitTestVisible="False" Width="332" TextAlignment="Center"/>
                    </Viewbox>
                </Button>
                <!-- Placeholder TextBlock -->
                <TextBox x:Name="SetRiskRangeTB"
                    Text="{Binding RiskRangeEdt.RiskRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource RiskRangeTextBoxStyle}" 
                    FontWeight="SemiBold"
                    FontSize="36"
                    Width="Auto" Height="Auto" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,5,10"/>
                <!-- Apply Button -->
                <Button Content="Apply"
                    Grid.Column="2"
                    Click="ApplyButton_Click"
                    Style="{StaticResource ApplyCancelStyle}" Grid.Row="1" Margin="5,0,0,10" MinWidth="90" MaxWidth="110" HorizontalAlignment="Left"/>

                <!-- Cancel Button -->
                <Button Content="Cancel"
                    Grid.Column="2"
                    Click="CancelButton_Click"
                    Style="{StaticResource ApplyCancelStyle}" Grid.Row="1" Margin="0,0,0,10" MinWidth="90" MaxWidth="110" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Border Background="#FF284151" CornerRadius="16" Grid.Row="2" MinWidth="500" MaxWidth="700" HorizontalAlignment="Center" Margin="0,5,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                </Grid.RowDefinitions>
                <Button CommandParameter="0" Click="Button_Status_Click" MaxHeight="80" Grid.Row="1" Grid.Column="1" MaxWidth="200">
                    <Viewbox>
                        <TextBlock Text="{Binding CallStatuses[0]}" IsHitTestVisible="False" Width="332" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Viewbox>
                 </Button>
                <Button CommandParameter="1" Click="Button_Status_Click" MaxHeight="80" Grid.Row="2" Grid.Column="1" MaxWidth="200">
                    <Viewbox>
                        <TextBlock Text="{Binding CallStatuses[1]}" IsHitTestVisible="False" Width="332" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Viewbox>
                </Button>
                <Button CommandParameter="2" Click="Button_Status_Click" MaxHeight="80" Grid.Row="3" Grid.Column="1" MaxWidth="200">
                    <Viewbox>
                        <TextBlock Text="{Binding CallStatuses[2]}" IsHitTestVisible="False" Width="332" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Viewbox>
                </Button>
                <Button CommandParameter="3" Click="Button_Status_Click" MaxHeight="80" Grid.Row="1" Grid.Column="2" MaxWidth="200">
                    <Viewbox>
                        <TextBlock Text="{Binding CallStatuses[3]}" IsHitTestVisible="False" Width="332" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Viewbox>
                </Button>
                <Button CommandParameter="4" Click="Button_Status_Click" MaxHeight="80" Grid.Row="2" Grid.Column="2" MaxWidth="200">
                    <Viewbox>
                        <TextBlock Text="{Binding CallStatuses[4]}" IsHitTestVisible="False" Width="332" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Viewbox>
                </Button>
                <Button CommandParameter="5" Click="Button_Status_Click" MaxHeight="80" Grid.Row="3" Grid.Column="2" MaxWidth="200">
                    <Viewbox>
                        <TextBlock Text="{Binding CallStatuses[5]}" IsHitTestVisible="False" Width="332" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>
        <!-- Right Section -->
        <Border Background="#FF284151" CornerRadius="16" BorderThickness="0" Grid.Column="1" Grid.Row="1" MaxHeight="300" MaxWidth="800" HorizontalAlignment="Left" Margin="0,0,150,5">
            <Border.Effect>
                <DropShadowEffect Opacity="0.25" BlurRadius="10" ShadowDepth="7.3" Direction="-75"/>
            </Border.Effect>
            <Grid>
                <Label 
                    FontSize="48" FontWeight="SemiBold" 
                    Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Background="#007690A3">
                    <Viewbox Margin="40,30,40,30">
                        <TextBlock Text="{Binding ConfigTime, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" />
                    </Viewbox>
                </Label>
            </Grid>
        </Border>
        <Border Background="#FF284151" BorderThickness="1" Margin="0,5,150,0" CornerRadius="16" MinHeight="300" Grid.Column="1" Grid.Row="2">
            <Border.Effect>
                <DropShadowEffect Opacity="0.25" BlurRadius="10" ShadowDepth="7.3" Direction="-75"/>
            </Border.Effect>
            <Grid MinHeight="350">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45*"/>
                    <ColumnDefinition Width="702*"/>
                    <ColumnDefinition Width="45*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="80*"/>
                    <RowDefinition Height="80*"/>
                    <RowDefinition Height="80*"/>
                    <RowDefinition Height="80*"/>
                    <RowDefinition Height="80*"/>
                    <RowDefinition Height="80*"/>
                    <RowDefinition Height="30*"/>
                </Grid.RowDefinitions>
                <Button Content="+1 Sec" Margin="0,4,0,11" Width="Auto" Height="auto" Click="PlusOneSec" Grid.Column="1" Grid.Row="1"/>
                <Button Content="+1 Min" Margin="0,10,0,9" Width="Auto" Height="Auto" Click="PlusOneMin" Grid.Row="2" Grid.Column="1"/>
                <Button Content="+1 Hour" Margin="0,8,0,9" Width="Auto" Height="Auto" Click="PlusOneHour" Grid.Row="3" Grid.Column="1"/>
                <Button Content="+1 Day" Margin="0,13,0,8" Width="Auto" Height="Auto" Click="PlusOneDay" Grid.Row="4" Grid.Column="1"/>
                <Button Content="+1 Month" Margin="0,11,0,10" Width="Auto" Height="Auto" Click="PlusOneMonth" Grid.Row="5" Grid.Column="1"/>
                <Button Content="+1 Year" Margin="0,10,0,10" Width="Auto" Height="Auto" Click="PlusOneYear" Grid.Row="6" Grid.Column="1"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
